# ============================================================
# SCDP Stock Information Platform — Environment Configuration
# Copy this file to .env and fill in the values
# ============================================================

# ---------------------
# Application
# ---------------------
APP_NAME="SCDP Stock Information Platform"
APP_ENV=development
APP_PORT=3000
API_PREFIX=api/v1

# ---------------------
# Target PostgreSQL Database (scdp_db)
# ---------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=scdp_db
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR_PASSWORD
DATABASE_SCHEMA=scdp
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scdp_db
DATABASE_SSL=false

# ---------------------
# SQL Server Master Source Database (BDGSM)
# ---------------------
SCDP_SOURCE_DB_HOST=localhost
SCDP_SOURCE_DB_PORT=1433
SCDP_SOURCE_DB_NAME=BDGSM
SCDP_SOURCE_DB_USER=YOUR_READ_ONLY_USER
SCDP_SOURCE_DB_PASSWORD=YOUR_PASSWORD
SCDP_SOURCE_DB_SCHEMA=dbo
SCDP_SOURCE_DB_DRIVER="ODBC Driver 18 for SQL Server"

# ---------------------
# Synchronization Engine
# ---------------------
# Set SYNC_USE_MOCK=false to connect to the real SQL Server BDGSM source DB
SYNC_USE_MOCK=true
SYNC_BATCH_SIZE=100
SYNC_TIMEOUT_MS=30000

# ---------------------
# JWT Authentication & Security
# ---------------------
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars-in-production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# ---------------------
# Logging
# ---------------------
LOG_LEVEL=debug
