# ============================================================
# SCDP Stock Information Platform — Environment Configuration
# Copy this file to .env and fill in the values
# ============================================================

# ---------------------
# Application
# ---------------------
APP_NAME="SCDP Stock Information Platform"
APP_ENV=development
APP_PORT=3000
API_PREFIX=api/v1

# ---------------------
# Application Database (PostgreSQL)
# ---------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=scdp_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scdp_db
DATABASE_SSL=false

# ---------------------
# JWT Authentication
# ---------------------
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars-in-production
JWT_EXPIRES_IN=24h

# ---------------------
# CORS
# ---------------------
CORS_ORIGIN=http://localhost:5173

# ---------------------
# SCDP Source Database
# Leave all empty until the real SCDP database becomes available.
# The application will start and run normally without these.
# ---------------------
SCDP_DB_HOST=10.66.2.56
SCDP_DB_PORT=1433
SCDP_DB_NAME=BDGSM
SCDP_DB_USER=
SCDP_DB_PASSWORD=
SCDP_DB_SCHEMA=dbo

# ---------------------
# Synchronization
# ---------------------
# Set SYNC_USE_MOCK=false and configure SCDP_DB_* when real SCDP DB is available
SYNC_USE_MOCK=true
SYNC_BATCH_SIZE=100
SYNC_TIMEOUT_MS=30000

# ---------------------
# Logging
# ---------------------
# Options: error | warn | log | debug | verbose
LOG_LEVEL=debug
